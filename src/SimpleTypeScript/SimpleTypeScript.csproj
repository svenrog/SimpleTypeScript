<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>SimpleTypeScript</PackageId>
    <Description>An emitter for generated TypeScript: build a module out of declarations, types and values, and it is spelled correctly once — string literals escaped for ECMAScript source rather than JSON, comments that cannot be closed from inside, numbers a parser reads the same in every culture, and byte-stable output across machines.</Description>
    <PackageTags>typescript;codegen;source-generator;emitter;ecmascript</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../LICENSE.txt" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- The icon is third-party under a license of its own, so the notice ships with the package that
         redistributes it rather than only with the repository. -->
    <None Include="../../icon.png" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
