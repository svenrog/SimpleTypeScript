<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both, because a package shipping two frameworks is only proven on the one its tests were run against. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Test methods and fixture classes don't carry XmlDoc; keep the doc-comment warning off here. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="2.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
    <!-- Compiles the README examples, so documentation cannot drift from the API. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SimpleTypeScript/SimpleTypeScript.csproj" />
    <ProjectReference Include="../../src/SimpleTypeScript.TypeGeneration/SimpleTypeScript.TypeGeneration.csproj" />
  </ItemGroup>

</Project>
